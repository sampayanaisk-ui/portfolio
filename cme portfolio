<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jessie Mae G. Garnoza — Bookkeeping & Administrative Support Specialist</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --white:#ffffff;
    --navy:#10243e;
    --navy-soft:#1c3556;
    --blue:#2c6fbb;
    --blue-deep:#1f558f;
    --blue-tint:#eaf2fb;
    --blue-tint-2:#f4f8fd;
    --slate:#5b6b7c;
    --line:#d8e3ee;
    --success:#2f8f5b;
    --radius:14px;
    --maxw:1120px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--white);
    color:var(--navy);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
    line-height:1.6;
  }
  h1,h2,h3,h4{font-family:'Fraunces',serif;color:var(--navy);margin:0;letter-spacing:-0.01em;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 32px;}
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  ::selection{background:var(--blue);color:#fff;}

  /* focus visibility */
  a:focus-visible, button:focus-visible{outline:2px solid var(--blue); outline-offset:3px;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important;}
  }

  /* ---------- NAV ---------- */
  header.site{
    position:sticky; top:0; z-index:50;
    background:rgba(255,255,255,0.92);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav.wrap{
    display:flex; align-items:center; justify-content:space-between;
    height:72px;
  }
  .brand{font-family:'Fraunces',serif; font-weight:600; font-size:19px; color:var(--navy);}
  .brand span{color:var(--blue);}
  .navlinks{display:flex; gap:30px; align-items:center;}
  .navlinks a{
    font-size:14.5px; font-weight:500; color:var(--slate);
    position:relative; padding:6px 0;
  }
  .navlinks a::after{
    content:""; position:absolute; left:0; bottom:0; height:2px; width:0;
    background:var(--blue); transition:width .25s ease;
  }
  .navlinks a:hover::after{width:100%;}
  .navlinks a:hover{color:var(--navy);}
  .nav-cta{
    background:var(--navy); color:#fff !important; padding:10px 20px;
    border-radius:999px; font-size:14px; font-weight:600;
  }
  .nav-cta:hover{background:var(--blue-deep);}
  .navlinks a.nav-cta::after{display:none;}
  .burger{display:none; background:none; border:none; cursor:pointer; padding:8px;}
  .burger span{display:block; width:22px; height:2px; background:var(--navy); margin:5px 0;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative; overflow:hidden;
    background:
      repeating-linear-gradient(to bottom, transparent 0, transparent 39px, var(--line) 40px),
      var(--white);
    padding:96px 0 80px;
  }
  .hero::before{
    content:""; position:absolute; top:0; right:-140px; width:520px; height:520px;
    background:radial-gradient(circle at center, var(--blue-tint) 0%, transparent 70%);
    z-index:0;
  }
  .hero .wrap{position:relative; z-index:1; display:grid; grid-template-columns:1.15fr 0.85fr; gap:56px; align-items:center;}
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'IBM Plex Mono',monospace; font-size:12.5px; letter-spacing:.08em; text-transform:uppercase;
    color:var(--blue-deep); background:var(--blue-tint); border:1px solid var(--line);
    padding:6px 14px; border-radius:999px; margin-bottom:22px;
  }
  .eyebrow::before{content:"●"; color:var(--success); font-size:9px;}
  .hero h1{font-size:46px; line-height:1.12; font-weight:600; max-width:11.5ch;}
  .hero h1 em{font-style:normal; color:var(--blue);}
  .hero p.lead{font-size:17px; color:var(--slate); max-width:46ch; margin-top:20px;}
  .hero .cta-row{display:flex; gap:14px; align-items:center; margin-top:32px; flex-wrap:wrap;}
  .btn-primary{
    background:var(--navy); color:#fff; padding:15px 28px; border-radius:10px;
    font-weight:600; font-size:15px; display:inline-flex; align-items:center; gap:10px;
    transition:transform .18s ease, background .18s ease; border:none; cursor:pointer;
  }
  .btn-primary:hover{background:var(--blue-deep); transform:translateY(-2px);}
  .btn-secondary{
    color:var(--navy); font-weight:600; font-size:15px; padding:15px 6px;
    border-bottom:2px solid var(--line);
  }
  .btn-secondary:hover{border-color:var(--blue);}

  /* Ledger balance widget — signature element */
  .ledger-card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius);
    box-shadow:0 24px 48px -20px rgba(16,36,62,0.18);
    padding:26px 26px 22px;
  }
  .ledger-card .lc-head{display:flex; justify-content:space-between; align-items:baseline; margin-bottom:18px;}
  .ledger-card .lc-head span{font-size:13px; color:var(--slate); font-family:'IBM Plex Mono',monospace;}
  .lc-cols{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  .lc-col{border:1px dashed var(--line); border-radius:10px; padding:16px;}
  .lc-col h4{font-size:12px; text-transform:uppercase; letter-spacing:.08em; color:var(--slate); font-family:'Inter',sans-serif; font-weight:600; margin-bottom:10px;}
  .lc-amount{font-family:'IBM Plex Mono',monospace; font-size:22px; font-weight:500; color:var(--navy);}
  .lc-status{
    margin-top:18px; display:flex; align-items:center; gap:10px;
    background:var(--blue-tint-2); border:1px solid var(--line); border-radius:10px; padding:12px 16px;
    font-size:13.5px; color:var(--navy-soft); font-weight:500;
  }
  .lc-check{
    width:20px; height:20px; border-radius:50%; background:var(--success); flex:0 0 auto;
    display:flex; align-items:center; justify-content:center;
  }
  .lc-check svg{width:12px; height:12px; stroke:#fff; stroke-width:3;}
  .lc-amount.tick{animation:tickIn .8s ease both;}
  @keyframes tickIn{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

  /* ---------- SECTION shells ---------- */
  section{padding:88px 0;}
  .section-tint{background:var(--blue-tint-2);}
  .kicker{
    font-family:'IBM Plex Mono',monospace; font-size:12.5px; letter-spacing:.1em; text-transform:uppercase;
    color:var(--blue-deep); margin-bottom:14px; display:block;
  }
  .section-head{max-width:640px; margin-bottom:48px;}
  .section-head h2{font-size:32px; font-weight:600;}
  .section-head p{color:var(--slate); margin-top:14px; font-size:15.5px;}

  /* ---------- ABOUT ---------- */
  .about-grid{display:grid; grid-template-columns:0.9fr 1.1fr; gap:56px; align-items:start;}
  .about-grid p{color:var(--slate); font-size:16px; margin-bottom:16px;}
  .stat-row{display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:28px;}
  .stat{border-left:2px solid var(--blue); padding-left:14px;}
  .stat .num{font-family:'IBM Plex Mono',monospace; font-size:24px; font-weight:500; color:var(--navy);}
  .stat .label{font-size:12.5px; color:var(--slate); margin-top:2px;}

  /* ---------- SKILLS ---------- */
  .skills-cols{display:grid; grid-template-columns:repeat(3,1fr); gap:28px;}
  .skill-block h3{font-size:15px; text-transform:uppercase; letter-spacing:.04em; margin-bottom:18px; color:var(--blue-deep); font-family:'Inter',sans-serif; font-weight:700;}
  .skill-list{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:12px;}
  .skill-list li{
    display:flex; align-items:center; gap:12px; font-size:14.5px; color:var(--navy-soft);
    background:#fff; border:1px solid var(--line); border-radius:10px; padding:12px 14px;
  }
  .skill-list li .ic{
    width:30px; height:30px; border-radius:8px; background:var(--blue-tint);
    display:flex; align-items:center; justify-content:center; flex:0 0 auto;
  }
  .skill-list li .ic svg{width:16px; height:16px; stroke:var(--blue-deep); fill:none; stroke-width:1.8;}

  /* ---------- SERVICES ---------- */
  .services-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  .service-card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:26px;
    transition:box-shadow .2s ease, transform .2s ease;
  }
  .service-card:hover{box-shadow:0 20px 40px -24px rgba(16,36,62,0.25); transform:translateY(-3px);}
  .service-card .ic{
    width:42px; height:42px; border-radius:10px; background:var(--navy); margin-bottom:16px;
    display:flex; align-items:center; justify-content:center;
  }
  .service-card .ic svg{width:20px; height:20px; stroke:#fff; fill:none; stroke-width:1.8;}
  .service-card h4{font-size:16.5px; font-weight:600; margin-bottom:8px;}
  .service-card p{font-size:14px; color:var(--slate); margin:0;}

  /* ---------- PORTFOLIO ---------- */
  .proj-grid{display:grid; grid-template-columns:1fr 1fr; gap:22px;}
  .proj-card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden;
  }
  .proj-top{padding:24px 26px 0;}
  .proj-index{font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--blue-deep); letter-spacing:.06em;}
  .proj-card h3{font-size:19px; margin:8px 0 14px; font-weight:600;}
  .proj-toggle{
    width:100%; text-align:left; background:none; border:none; cursor:pointer;
    padding:16px 26px; display:flex; justify-content:space-between; align-items:center;
    border-top:1px solid var(--line); font-weight:600; font-size:14px; color:var(--navy); margin-top:16px;
  }
  .proj-toggle .plus{transition:transform .25s ease; font-size:18px; color:var(--blue);}
  .proj-card.open .proj-toggle .plus{transform:rotate(45deg);}
  .proj-body{
    max-height:0; overflow:hidden; transition:max-height .35s ease;
    padding:0 26px;
  }
  .proj-card.open .proj-body{max-height:520px; padding-bottom:24px;}
  .proj-body h5{font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--blue-deep); margin:16px 0 8px;}
  .proj-body ul{margin:0; padding-left:18px; color:var(--slate); font-size:14px;}
  .proj-body ul li{margin-bottom:5px;}
  .proj-body .tools{display:flex; flex-wrap:wrap; gap:8px; margin-top:6px;}
  .tool-pill{
    background:var(--blue-tint); color:var(--blue-deep); font-size:12.5px; font-weight:600;
    padding:5px 11px; border-radius:999px;
  }
  .outcome-box{
    margin-top:14px; background:var(--blue-tint-2); border-left:3px solid var(--success);
    padding:10px 14px; border-radius:6px; font-size:13.5px; color:var(--navy-soft);
  }

  /* ---------- WHY HIRE ---------- */
  .why-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:18px;}
  .why-card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:22px 20px;
    text-align:left;
  }
  .why-card .ic{
    width:36px; height:36px; border-radius:8px; background:var(--blue-tint); margin-bottom:14px;
    display:flex; align-items:center; justify-content:center;
  }
  .why-card .ic svg{width:18px; height:18px; stroke:var(--blue-deep); fill:none; stroke-width:2;}
  .why-card h4{font-size:15px; font-weight:600; margin-bottom:6px;}
  .why-card p{font-size:13.5px; color:var(--slate); margin:0;}

  /* ---------- TESTIMONIALS ---------- */
  .test-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  .test-card{
    background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:26px;
    display:flex; flex-direction:column; gap:16px;
  }
  .test-card .quote-mark{font-family:'Fraunces',serif; font-size:40px; color:var(--blue); line-height:1; opacity:.5;}
  .test-card p.quote{font-size:14.5px; color:var(--navy-soft); font-style:italic; margin:0;}
  .test-person{display:flex; align-items:center; gap:12px; margin-top:auto;}
  .avatar{
    width:38px; height:38px; border-radius:50%; background:var(--navy); color:#fff;
    display:flex; align-items:center; justify-content:center; font-family:'Fraunces',serif; font-weight:600; font-size:14px;
  }
  .test-person .name{font-size:13.5px; font-weight:600; color:var(--navy);}
  .test-person .role{font-size:12px; color:var(--slate);}

  /* ---------- CONTACT ---------- */
  .contact-banner{
    background:var(--navy); border-radius:20px; padding:64px 56px; position:relative; overflow:hidden;
  }
  .contact-banner::after{
    content:""; position:absolute; inset:0;
    background:repeating-linear-gradient(to bottom, transparent 0, transparent 39px, rgba(255,255,255,0.04) 40px);
    pointer-events:none;
  }
  .contact-banner h2{color:#fff; font-size:30px; max-width:16ch;}
  .contact-banner p{color:#c7d4e5; font-size:15.5px; max-width:48ch; margin-top:14px;}
  .contact-links{display:flex; gap:14px; flex-wrap:wrap; margin-top:34px; position:relative; z-index:1;}
  .contact-pill{
    display:flex; align-items:center; gap:10px; background:rgba(255,255,255,0.08);
    border:1px solid rgba(255,255,255,0.16); color:#fff; padding:13px 20px; border-radius:10px;
    font-size:14px; font-weight:500; transition:background .2s ease;
  }
  .contact-pill:hover{background:rgba(255,255,255,0.16);}
  .contact-pill svg{width:17px; height:17px; stroke:#fff; fill:none; stroke-width:1.8;}
  .contact-cta{margin-top:34px; position:relative; z-index:1;}
  .contact-cta .btn-primary{background:var(--blue); }
  .contact-cta .btn-primary:hover{background:#3f7fca;}

  footer.site{padding:36px 0; text-align:center; color:var(--slate); font-size:13px;}

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:920px){
    .hero .wrap{grid-template-columns:1fr;}
    .hero h1{font-size:36px; max-width:none;}
    .about-grid, .skills-cols, .why-grid, .test-grid, .proj-grid, .services-grid{grid-template-columns:1fr 1fr;}
    .about-grid{grid-template-columns:1fr;}
  }
  @media (max-width:680px){
    .navlinks{position:fixed; top:72px; left:0; right:0; background:#fff; flex-direction:column;
      padding:20px 24px; border-bottom:1px solid var(--line); gap:16px; transform:translateY(-130%);
      transition:transform .25s ease;}
    .navlinks.open{transform:translateY(0);}
    .burger{display:block;}
    .skills-cols, .why-grid, .test-grid, .proj-grid, .services-grid, .stat-row{grid-template-columns:1fr;}
    .contact-banner{padding:40px 24px;}
    section{padding:64px 0;}
  }
</style>
</head>
<body>

<header class="site">
  <nav class="wrap">
    <a href="#top" class="brand">Jessie Mae <span>Garnoza</span></a>
    <div class="navlinks" id="navlinks">
      <a href="#about">About</a>
      <a href="#skills">Skills</a>
      <a href="#services">Services</a>
      <a href="#portfolio">Portfolio</a>
      <a href="#why">Why Me</a>
      <a href="#testimonials">Testimonials</a>
      <a href="#contact" class="nav-cta">Let's Talk</a>
    </div>
    <button class="burger" id="burger" aria-label="Toggle menu"><span></span><span></span><span></span></button>
  </nav>
</header>

<main id="top">

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow">Available for freelance & remote work</span>
        <h1>Books balanced. Deadlines met. <em>Nothing missed.</em></h1>
        <p class="lead">I'm Jessie Mae — a bookkeeping and administrative support specialist who keeps your records accurate, your reports on time, and your day-to-day admin off your plate.</p>
        <div class="cta-row">
          <a href="#contact" class="btn-primary">Let's Work Together
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#portfolio" class="btn-secondary">See sample work</a>
        </div>
      </div>
      <div class="ledger-card" id="ledgerCard">
        <div class="lc-head">
          <strong style="font-family:'Fraunces',serif; font-size:16px;">Monthly Reconciliation</strong>
          <span class="mono">as of this month</span>
        </div>
        <div class="lc-cols">
          <div class="lc-col">
            <h4>Debit</h4>
            <div class="lc-amount mono" id="lcDebit">₱0.00</div>
          </div>
          <div class="lc-col">
            <h4>Credit</h4>
            <div class="lc-amount mono" id="lcCredit">₱0.00</div>
          </div>
        </div>
        <div class="lc-status">
          <span class="lc-check"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span id="lcStatusText">Reconciling…</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="wrap about-grid">
      <div>
        <span class="kicker">About</span>
        <h2>Someone you can hand your books to and stop worrying.</h2>
      </div>
      <div>
        <p>I'm a detail-oriented and reliable professional with hands-on experience in QuickBooks, Microsoft Excel, and Microsoft Word. I enjoy the work most people find tedious — organizing financial records, keeping data accurate, and handling the administrative details that let a business run smoothly.</p>
        <p>I take deadlines seriously, double-check my own work before it reaches you, and I'm always learning to do the job better. If you need someone dependable to own the numbers and the paperwork, that's exactly where I fit.</p>
        <div class="stat-row">
          <div class="stat"><div class="num">15+</div><div class="label">Core tools &amp; skills</div></div>
          <div class="stat"><div class="num">100%</div><div class="label">Deadline commitment</div></div>
          <div class="stat"><div class="num">1:1</div><div class="label">Direct, clear communication</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="section-tint">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">Skills</span>
        <h2>What I bring to your books and your inbox</h2>
      </div>
      <div class="skills-cols">
        <div class="skill-block">
          <h3>Software</h3>
          <ul class="skill-list">
            <li><span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5"/></svg></span>QuickBooks</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 9v12"/></svg></span>Microsoft Excel</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M9 13h6M9 17h6"/></svg></span>Microsoft Word</li>
          </ul>
        </div>
        <div class="skill-block">
          <h3>Core Tasks</h3>
          <ul class="skill-list">
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"/></svg></span>Data Entry</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>Bookkeeping Support</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5"/></svg></span>Invoice Creation</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M3 3v18h18M7 15l4-4 3 3 5-6"/></svg></span>Expense Tracking</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg></span>Financial Record Management</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M3 3h18v18H3zM3 9h18M9 9v12"/></svg></span>Spreadsheet Management</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5V6.5A2.5 2.5 0 0 1 6.5 4H20v15"/></svg></span>Document Formatting</li>
          </ul>
        </div>
        <div class="skill-block">
          <h3>Support &amp; Habits</h3>
          <ul class="skill-list">
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/></svg></span>Administrative Support</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M3 7l9 6 9-6M4 4h16v16H4z"/></svg></span>File Organization</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM4 8l8 5 8-5"/></svg></span>Email Management</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>Time Management</li>
            <li><span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.5"/></svg></span>Attention to Detail</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services">
    <div class="wrap">
